# URL publique du site (métadonnées, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Catalogue : « local » (données du dépôt, par défaut) ou « shopify »
COMMERCE_PROVIDER=local
# Shopify Storefront API (si COMMERCE_PROVIDER=shopify)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-10

# Paiement Stripe Checkout (clé de TEST sk_test_…). Vide : mode démonstration, sans paiement.
STRIPE_SECRET_KEY=
# Secret du webhook (stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# Courriels : Resend si une clé est fournie, sinon fichiers HTML dans .outbox/
RESEND_API_KEY=
MAIL_FROM="Maison Aurèle <salon@maison-aurele.example>"
MAIL_OUTBOX_DIR=.outbox
